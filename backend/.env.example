# --- Application ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL) ---
PGHOST=localhost
PGPORT=5432
PGUSER=crm
PGPASSWORD=crm_dev_password
PGDATABASE=crm_dev

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=900s
REFRESH_SECRET=change-me-to-a-different-long-random-secret
REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
EMAIL_VERIFICATION_REQUIRED=false

# --- Rate limiting ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=300
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=10
